# Copy this file to `.env` and fill in your own values.
# Never commit `.env` to git.

# Token from @BotFather in Telegram (mandatory).
BOT_TOKEN=

# SQLite by default. To use Postgres later, set e.g.
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/expenses
DATABASE_URL=sqlite:///data/bot.db

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Default timezone for the user's local week/month boundaries (iteration 2).
REPORT_TZ=Europe/Nicosia
